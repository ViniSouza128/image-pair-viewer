# Imagens (são processadas só no browser; nunca devem entrar no repo)
*.jpg
*.jpeg
*.png
*.webp
*.heic
*.avif
*.gif
*.bmp

# Exceção: pasta samples/ traz os exemplos embutidos do GitHub Pages
# (pares before/after de demonstração). São CC BY-SA / domínio público —
# créditos completos em CREDITS.md.
!samples/
!samples/**

# Exceção: pasta icons/ traz os ícones PWA (PNG gerados por
# _icons_build.py). Necessários pra instalação e splash screen.
!icons/
!icons/**

# Arquivos de sistema / editor
.DS_Store
Thumbs.db
desktop.ini
*.swp
.vscode/
.idea/

# Scripts / artefatos temporários (mas os builders oficiais são mantidos)
_*.py
!_build.py
!_samples_build.py
!_icons_build.py
!_og_build.py
_*.html
*.tmp.js

# Open Graph share image (1200x630, gerada por _og_build.py).
# Necessária pro preview no WhatsApp/Twitter/LinkedIn/Facebook funcionar.
!og-image.jpg

